# frozen_string_literal: true

# Benchmarks and real-socket semantics specs for the 1.2 persistent-connection
# spike. Kept out of the root Gemfile so the gem's own dependencies (and CI)
# are unchanged:
#
#   BUNDLE_GEMFILE=bench/Gemfile bundle install
#   BUNDLE_GEMFILE=bench/Gemfile bundle exec rspec bench/spec
#   BUNDLE_GEMFILE=bench/Gemfile bundle exec ruby bench/http_bench.rb

source "https://rubygems.org"

gem "clicksend", path: ".."
gem "faraday-net_http_persistent", "~> 2.3"
gem "net-http-persistent", "~> 4.0"
gem "rspec", "~> 3.13"
